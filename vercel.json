{
  "buildCommand": "npm exec --yes --package=esbuild@0.25.6 -- esbuild karaoke-display.js karaoke-sessions.js admin-presence.js app-dialogs.js firebase-config.js --target=es2015 --outdir=assets/compat",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/admin-dashboard.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/display",
      "destination": "/karaoke-display.html"
    }
  ],
  "redirects": [
    {
      "source": "/singer.html",
      "destination": "/performer-portal.html",
      "permanent": true
    },
    {
      "source": "/singer-portal.html",
      "destination": "/performer-portal.html",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin-dashboard.html",
      "permanent": true
    },
    {
      "source": "/tv-display.html",
      "destination": "/karaoke-display.html",
      "permanent": true
    },
    {
      "source": "/tv-display.js",
      "destination": "/karaoke-display.js",
      "permanent": true
    }
  ]
}
